# ---------------------------------------------------------------------------
# Veritas configuration
# Copy to `.env.local` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# AI provider: "gemini" for the real model, "mock" for deterministic offline demos/tests.
AI_PROVIDER=mock

# Google AI Studio / Gemini API key. Server-side only. In production this is
# injected from Secret Manager (see cloudbuild.yaml) — never baked into the image.
GEMINI_API_KEY=

# Model used for planning, verification and synthesis. Pinned to a stable Flash
# release; set `gemini-flash-latest` to always track the current one.
GEMINI_MODEL=gemini-3.8-flash

# Hard timeouts and budgets (milliseconds). Keep requests bounded and predictable.
AGENT_TIMEOUT_MS=20000
RESEARCH_TIMEOUT_MS=55000

# Per-IP rate limit for /api/research (requests per window / window in ms).
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=60000

# Comma-separated allowlist of hosts the retriever may fetch from.
# This is a security control against SSRF — do not add arbitrary domains.
RETRIEVAL_ALLOWED_HOSTS=en.wikipedia.org

# Optional: Google Cloud project id, surfaced in /api/health for ops.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=

# Optional: public links rendered in the UI (defaults are safe for local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPO_URL=https://github.com
