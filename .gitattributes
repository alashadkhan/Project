# Normalise line endings in the repository so Docker, CI and Cloud Shell all see
# the same bytes. Shell scripts must keep LF or they fail with "bad interpreter".
* text=auto eol=lf

*.sh      text eol=lf
*.mjs     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

*.png     binary
*.ico     binary
*.jpg     binary
